{
  "name": "graspgen_generator",
  "description": "GraspGen Generator with pointnet backbone",
  "onnx_path": "models/onnx/graspgen_generator_pointnet.onnx",
  "hbm_name": "graspgen_generator_pointnet.hbm",
  "inputs": [
    {
      "name": "pc",
      "description": "Input point cloud (normalized)",
      "shape": [
        "B",
        "N",
        "3"
      ],
      "concrete_shape": [
        1,
        2048,
        3
      ],
      "dtype": "float32",
      "range": [
        -1.0,
        1.0
      ]
    },
    {
      "name": "noisy_grasps",
      "description": "Current noisy grasp samples",
      "shape": [
        "B*K",
        "D"
      ],
      "concrete_shape": [
        20,
        6
      ],
      "dtype": "float32"
    },
    {
      "name": "timestep",
      "description": "Current diffusion timestep",
      "shape": [
        "1"
      ],
      "concrete_shape": [
        1
      ],
      "dtype": "int64"
    }
  ],
  "outputs": [
    {
      "name": "noise_pred",
      "description": "Predicted noise for the denoising step",
      "shape": [
        "B*K",
        "D"
      ],
      "concrete_shape": [
        20,
        6
      ],
      "dtype": "float32"
    }
  ],
  "config": {
    "num_diffusion_iters_eval": 20,
    "obs_backbone": "pointnet",
    "grasp_repr": "r3_so3",
    "batch_size": 1
  },
  "metadata": {
    "target_platform": "horizon_s600",
    "optimization_hints": {
      "core_num": 2,
      "optimize_level": "O2",
      "quantization": "int16",
      "calibration_type": "max"
    }
  }
}