{
  "name": "graspgen_generator",
  "description": "GraspGen Generator with pointnet backbone",
  "onnx_path": "models/onnx/graspgen_generator_pointnet.onnx",
  "hbm_name": "graspgen_generator_pointnet.hbm",
  "inputs": [
    {
      "name": "pc",
      "description": "Input point cloud (normalized)",
      "shape": [
        "B",
        "N",
        "3"
      ],
      "concrete_shape": [
        1,
        2048,
        3
      ],
      "dtype": "float32",
      "range": [
        -1.0,
        1.0
      ]
    }
  ],
  "outputs": [
    {
      "name": "grasps_pred",
      "description": "Predicted grasp poses",
      "shape": [
        "B",
        "K",
        "D"
      ],
      "concrete_shape": [
        1,
        20,
        9
      ],
      "dtype": "float32"
    }
  ],
  "config": {
    "num_diffusion_iters_eval": 20,
    "obs_backbone": "pointnet",
    "grasp_repr": "r3_6d",
    "batch_size": 1
  },
  "metadata": {
    "target_platform": "horizon_s600",
    "optimization_hints": {
      "core_num": 2,
      "optimize_level": "O2",
      "quantization": "int16",
      "calibration_type": "max"
    }
  }
}